# Copie para .env e preencha. O .env NÃO vai para o git.
#   cp .env.example .env

# -------------- INFLUX DB --------------
# Estes quatro são usados pelo container do Influx APENAS na primeira subida,
# para criar o usuário, a org, o bucket e o token. Depois disso os dados já
# estão no volume e mudar aqui não altera mais nada no banco.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=          # mínimo 8 caracteres — é a senha de login em http://localhost:8086
INFLUXDB_ORG=tcc
# não altere: os dashboards versionados consultam este bucket pelo nome
INFLUXDB_BUCKET=internet_metrics

# Token que o peer usa para escrever e o Grafana para ler.
# Gere um com:  openssl rand -hex 32
INFLUXDB_TOKEN=

# Nome da série no Influx (lido só pelo peer, em config.py)
# não altere: os dashboards versionados consultam esta série pelo nome
INFLUXDB_MEASUREMENT=tests_results

# Usado quando você roda o peer fora do Docker, direto no venv.
# Dentro do compose, o serviço peer define esta URL sozinho.
INFLUXDB_URL=http://localhost:8086

# -------------- GRAFANA --------------
GRAFANA_PASSWORD=           # senha do usuário admin em http://localhost:3000

# -------------- TURN (opcional) --------------
# Chave da sua conta em metered.ca. Sem ela o peer cai para o STUN público do
# Google e funciona, mas sem relay — conexões atrás de NAT restritivo falham.
TURN_API_KEY=

# -------------- PEER --------------
# Seu UID/GID, para o results.csv não sair pertencendo ao root.
# Descubra com:  id -u   e   id -g
APP_UID=1000
APP_GID=1000
