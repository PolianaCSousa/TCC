# Copy to .env and fill in:  cp .env.example .env

# -------------- INFLUX DB --------------
# Used by the Influx container only on the first start.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=          # minimum 8 characters
INFLUXDB_ORG=tcc
# do not change: the versioned dashboards query this bucket by name
INFLUXDB_BUCKET=internet_metrics

# Token used by the peer and Grafana. Generate with:  openssl rand -hex 32
INFLUXDB_TOKEN=

# do not change: the versioned dashboards query this measurement by name
INFLUXDB_MEASUREMENT=tests_results

# Used when running the peer outside Docker; in compose the peer service sets the URL.
INFLUXDB_URL=http://localhost:8086

# -------------- GRAFANA --------------
GRAFANA_PASSWORD=           # admin user password at http://localhost:3000

# -------------- PEER --------------
# Your UID/GID (id -u, id -g), so results.csv is not owned by root.
APP_UID=1000
APP_GID=1000
